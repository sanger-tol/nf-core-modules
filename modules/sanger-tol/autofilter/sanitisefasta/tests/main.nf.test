nextflow_process {

    name "Test Process AUTOFILTER_SANITISEFASTA"
    script "../main.nf"
    process "AUTOFILTER_SANITISEFASTA"

    config "../nextflow.config"

    tag "modules"
    tag "modules_sangertol"
    tag "autofilter"
    tag "autofilter/sanitisefasta"
    tag "nf-core/gunzip"
    tag "subworkflows/../../modules/nf-core/gunzip"

    setup {

        nfcoreInitialise("${launchDir}/library/")
        nfcoreInstall("${launchDir}/library/", ["gunzip"])
        nfcoreLink("${launchDir}/library/", "${baseDir}/modules/")

        run("GUNZIP") {
            script "../../../../nf-core/gunzip/main.nf"
            process {
                """
                input[0] = [
                    [ id: "Laetiporus_sulphureus" ],
                    file(params.modules_testdata_base_path + 'Laetiporus_sulphureus/assembly/release/gfLaeSulp1.1/insdc/GCA_927399515.1.fasta.gz', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("Laetiporus_sulphureus - fasta") {

        when {
            process {
                """
                input[0] = GUNZIP.out.gunzip
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Laetiporus_sulphureus - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = GUNZIP.out.gunzip
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
