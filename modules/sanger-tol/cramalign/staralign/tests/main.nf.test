nextflow_process {

    name "Test Process CRAMALIGN_STARALIGN"
    script "../main.nf"
    process "CRAMALIGN_STARALIGN"

    tag "modules"
    tag "modules_sangertol"
    tag "star/genomegenerate"
    tag "cramalign"
    tag "cramalign/staralign"
    tag "nf-core/star/genomegenerate"

    config "./nextflow.config"

    setup {
        nfcoreInitialise("${launchDir}/library/")
        nfcoreInstall("${launchDir}/library/", ["star/genomegenerate"])
        nfcoreLink("${launchDir}/library/", "${baseDir}/modules")

        run("STAR_GENOMEGENERATE") {
            script "../../../../nf-core/star/genomegenerate/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [ id: "test" ],
                    file(params.modules_testdata_base_path + 'Meles_meles/assembly/release/mMelMel3.1_paternal_haplotype/GCA_922984935.2.subset.fasta', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id: "test" ],
                    file(params.modules_testdata_base_path + 'Meles_meles/assembly/release/mMelMel3.2_paternal_haplotype/insdc/genes.gtf', checkIfExists: true)
                ])
                """
            }
        }
    }
    test("Meles meles - illumina - cram") {

        when {
            process {
                """

                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'Meles_meles/genomic_data/mMelMel1/illumina/31231_3_1.subset.cram', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'Meles_meles/genomic_data/mMelMel1/illumina/31231_3_1.subset.cram.crai', checkIfExists: true),
                     ['@RG\\\\tID:31231_3#1\\\\tPL:ILLUMINADS:ERP114452\\\\tSM:SAMEA5962962']
                ])
                input[1] = Channel.of([
                    [ id: 'test'],
                    file(params.modules_testdata_base_path + 'Meles_meles/assembly/release/mMelMel3.2_paternal_haplotype/insdc/GCA_922984935.2.subset.fasta.gz', checkIfExists: true)
                ]).join(STAR_GENOMEGENERATE.out.index).map{ meta, assembly, index -> [meta, index, assembly] }
                input[2] = channel.of([
                    1, [0, 15]
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
		{ assert snapshot(
		    sanitizeOutput(process.out, readsMD5Keys: ["bam"])
			.findAll { key, val -> key.startsWith('versions') || key == 'bam' }
		).match() }
            )
        }
    }

    test("Meles meles - illumina - cram - stub") {

        options "-stub"

        when {
            process {
                """

                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'Meles_meles/genomic_data/mMelMel1/illumina/31231_3_1.subset.cram', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'Meles_meles/genomic_data/mMelMel1/illumina/31231_3_1.subset.cram.crai', checkIfExists: true),
                     ['@RG\\\\tID:31231_3#1\\\\tPL:ILLUMINADS:ERP114452\\\\tSM:SAMEA5962962']
                ])
                input[1] = Channel.of([
                    [ id: 'test'],
                    file(params.modules_testdata_base_path + 'Meles_meles/assembly/release/mMelMel3.1_paternal_haplotype/GCA_922984935.2.subset.fasta.gz', checkIfExists: true)
                ]).join(STAR_GENOMEGENERATE.out.index).map{ meta, assembly, index -> [meta, index, assembly] }
                input[2] = channel.of([
                    1, [0, 15]
                ])

                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
