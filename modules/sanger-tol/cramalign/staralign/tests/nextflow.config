nextflow.enable.moduleBinaries = true

process {
    withName: STAR_GENOMEGENERATE {
        memory   =  2.Gb
        cpus     =  4
    }
    withName: "CRAMALIGN_STARALIGN" {
        ext.args        = ""
        ext.args2         = { "--readFilesSAMattrKeep All --outSAMmode Full" }
        ext.args3        = '-m'
        ext.args4        = ""
        ext.args5        = ""
    }
}
