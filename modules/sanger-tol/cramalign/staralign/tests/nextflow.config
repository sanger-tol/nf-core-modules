nextflow.enable.moduleBinaries = true

process {
    withName: STAR_GENOMEGENERATE {
        memory   =  2.Gb
        cpus     =  4
    }
    withName: "CRAMALIGN_STARALIGN" {
        ext.args         = { "--outSAMtype BAM Unsorted --readFilesType SAM PE  --readFilesSAMattrKeep All --outStd BAM_Unsorted --outSAMmode Full" }
        ext.args2        = '-m'
        ext.args3        = ""
        ext.args4        = ""
    }
}
