nextflow_process {

    name "Test Process TELOMERE_FINDTELOMERE"
    script "../main.nf"
    process "TELOMERE_FINDTELOMERE"

    tag "modules"
    tag "modules_sangertol"
    tag "telomere"
    tag "telomere/findtelomere"

    config "./nextflow.config"

    test("GCA_963859965.1 - fasta - no split") {

        when {
            params {
                    find_telomere_args      = ""
                    java_args               = "99.9 0.01"
            }
            process {
                """
                input[0] = [
                    [ id: "Cloeon_Dipeterum" ],
                    file(params.modules_testdata_base_path + 'Cloeon_dipterum/assembly/release/ieCloDipt1.1/insdc/GCA_949628265.1.fasta.gz', checkIfExists: true),
                    "CCTAA"
                ]
                input[1] = false // split_windows
                """
            }
        }

        then {
            // No-split: telomere TSV + combined telomere.bed + windows (no strand tracks).
            // Windows MD5 and Java patch can differ across runners — names / major.minor only.
            def file_names = { ch ->
                ch.collect { meta, f -> [ meta.id, file(f).name ] }.sort()
            }
            def java_major_minor = process.out.versions_java.collect { proc, name, ver ->
                [ proc, name, (ver.toString() =~ /^(\d+\.\d+)/)[0][1] ]
            }
            assertAll(
                { assert process.success },
                { assert process.out.telomere_bed_fwd.isEmpty() },
                { assert process.out.telomere_bed_rev.isEmpty() },
                { assert process.out.windows_fwd.isEmpty() },
                { assert process.out.windows_rev.isEmpty() },
                { assert snapshot(
                    process.out.telomere,
                    process.out.telomere_bed,
                    file_names(process.out.windows_all),
                    [
                        versions_find_telomere: process.out.versions_find_telomere,
                        versions_java: java_major_minor
                    ]
                ).match() }
            )
        }
    }

    test("GCA_963859965.1 - fasta - split") {

        when {
            params {
                    find_telomere_args      = ""
                    java_args               = "99.9 0.01"
            }
            process {
                """
                input[0] = [
                    [ id: "Cloeon_Dipeterum" ],
                    file(params.modules_testdata_base_path + 'Cloeon_dipterum/assembly/release/ieCloDipt1.1/insdc/GCA_949628265.1.fasta.gz', checkIfExists: true),
                    "CCTAA"
                ]
                input[1] = true // split_windows
                """
            }
        }

        then {
            def file_names = { ch ->
                ch.collect { meta, f -> [ meta.id, file(f).name ] }.sort()
            }
            def java_major_minor = process.out.versions_java.collect { proc, name, ver ->
                [ proc, name, (ver.toString() =~ /^(\d+\.\d+)/)[0][1] ]
            }
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.telomere,
                    process.out.telomere_bed,
                    process.out.telomere_bed_fwd,
                    process.out.telomere_bed_rev,
                    file_names(process.out.windows_all),
                    file_names(process.out.windows_fwd),
                    file_names(process.out.windows_rev),
                    [
                        versions_find_telomere: process.out.versions_find_telomere,
                        versions_java: java_major_minor
                    ]
                ).match() }
            )
        }
    }

    test("GCA_963859965.1 - fasta - stub") {

        options "-stub"

        when {
            params {
                    find_telomere_args      = ""
                    java_args               = "99.9 0.01"
            }
            process {
                """
                input[0] = [
                    [ id: "Cloeon_Dipeterum" ],
                    file(params.modules_testdata_base_path + 'Cloeon_dipterum/assembly/release/ieCloDipt1.1/insdc/GCA_949628265.1.fasta.gz', checkIfExists: true),
                    "CCTAA"
                ]
                input[1] = false
                """
            }
        }

        then {
            def file_names = { ch ->
                ch.collect { meta, f -> [ meta.id, file(f).name ] }.sort()
            }
            def java_major_minor = process.out.versions_java.collect { proc, name, ver ->
                [ proc, name, (ver.toString() =~ /^(\d+\.\d+)/)[0][1] ]
            }
            assertAll(
                { assert process.success },
                { assert process.out.telomere_bed_fwd.isEmpty() },
                { assert process.out.telomere_bed_rev.isEmpty() },
                { assert process.out.windows_fwd.isEmpty() },
                { assert process.out.windows_rev.isEmpty() },
                { assert snapshot(
                    process.out.telomere,
                    process.out.telomere_bed,
                    file_names(process.out.windows_all),
                    [
                        versions_find_telomere: process.out.versions_find_telomere,
                        versions_java: java_major_minor
                    ]
                ).match() }
            )
        }
    }
}
