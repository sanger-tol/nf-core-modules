// Keep resource requests within local / CI runners that expose 2 CPUs
// (global tests/config/nf-test.config defaults to process.cpus = 4).
executor {
    cpus = 2
}

process {
    cpus = 2

    withName: TELOMERE_FINDTELOMERE {
        ext.args = { "${params.find_telomere_args}"      }
        ext.args2 = { "${params.java_args}" }
    }
}
