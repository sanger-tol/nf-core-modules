nextflow_process {

    name "Test Process TRIMGALORE"
    script "../main.nf"
    process "TRIMGALORE"

    tag "modules"
    tag "modules_sangertol"
    tag "trimgalore"

    config './nextflow.config'

    test("mMelMel_illumina - cram") {


        when {
            params{
                trimgalore_args = "--fastqc"
            }
            process {
                """

                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'Meles_meles/genomic_data/mMelMel1/illumina/31231_3_1.subset.cram', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(
                    process.out,
                    unstableKeys: ["html", "zip"]
                )).match() }
            )
        }

    }

    test("mMelMel_illumina - cram - stub") {

        options "-stub"

        when {
            params{
                trimgalore_args = ""
            }
            process {
                """

                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'Meles_meles/genomic_data/mMelMel1/illumina/31231_3_1.subset.cram', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
