nextflow.enable.moduleBinaries = true

params {
    longc_pairtoolsparse2_args = '--single-end --readid-transform "readID.split(\\":\\")[0]"'
    cooler_cload_args          = '-0 -c1 2 -p1 3 -c2 4 -p2 5'
}

process {
    withName: 'LONGC_PAIRTOOLSPARSE2' {
        ext.args = { params.longc_pairtoolsparse2_args }
    }

    withName: 'PAIRTOOLS_DEDUP' {
        ext.args = '--chunksize 100000'
    }

    // pairtools imports matplotlib; default config path may be read-only on NFS
    withName: /PAIRTOOLS_.*|LONGC_PAIRTOOLSPARSE2/ {
        env.MPLCONFIGDIR = { "${task.workDir}/.matplotlib" }
        env.XDG_CACHE_HOME = { "${task.workDir}/.cache" }
    }

    // Avoid sorting in-place: input and output must differ for Nextflow publishing
    withName: 'PAIRTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
    }

    // parse2 emits ${meta.id}.pairs.gz; restrict must not overwrite its own input
    withName: 'PAIRTOOLS_RESTRICT' {
        ext.prefix = { "${meta.id}.restricted" }
    }

    withName: 'COOLER_CLOAD' {
        ext.args = { params.cooler_cload_args }
    }
}
