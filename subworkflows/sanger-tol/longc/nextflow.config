nextflow.enable.moduleBinaries = true

params {
    // Match wf-pore-c parse2: --expand makes all pairwise contacts on a multi-fragment walk.
    // --min-mapq 0: pairtools default is 1; keep MAPQ0 alignments for denser Pretext.
    longc_pairtoolsparse2_args = '--single-end --expand --drop-sam --drop-seq --add-pair-index --min-mapq 0 --readid-transform "readID.split(\\":\\")[0]"'
    cooler_cload_args          = '-0 -c1 2 -p1 3 -c2 4 -p2 5'
}

process {
    // PacBio HiFi / CiFi
    withName: /.*:MINIMAP2_INDEX/ {
        ext.args = '-x map-hifi'
    }
    withName: /.*:MINIMAP2_ALIGN/ {
        ext.args = '-ax map-hifi'
    }

    // Keep supplementary alignments for multi-monomer CiFi walks (secondary always dropped)
    withName: 'LONGC_ANNOTATEFRAG' {
        ext.args = '--no-primary-only'
    }

    withName: 'LONGC_PAIRTOOLSPARSE2' {
        ext.args = { params.longc_pairtoolsparse2_args }
    }

    withName: 'PAIRTOOLS_DEDUP' {
        ext.args = '--chunksize 100000'
    }

    withName: /PAIRTOOLS_.*|LONGC_PAIRTOOLSPARSE2/ {
        env.MPLCONFIGDIR = { "${task.workDir}/.matplotlib" }
        env.XDG_CACHE_HOME = { "${task.workDir}/.cache" }
    }

    // Avoid sorting in-place: input and output must differ for Nextflow publishing.
    // pairtools/sort uses task.memory.toGiga() for --memory; must be set.
    withName: 'PAIRTOOLS_SORT' {
        memory = 8.GB
        ext.prefix = { "${meta.id}.sorted" }
    }

    // parse2 emits ${meta.id}.pairs.gz; restrict must not overwrite its own input
    withName: 'PAIRTOOLS_RESTRICT' {
        ext.prefix = { "${meta.id}.restricted" }
    }

    withName: 'COOLER_CLOAD' {
        ext.args = { params.cooler_cload_args }
    }

    // Keep low-MAPQ contacts for denser curation signal (PretextMap default is --mapq 10)
    withName: 'PRETEXTMAP' {
        ext.args = '--mapq 0 --sortby nosort'
    }
}
