includeConfig '../nextflow.config'

nextflow.enable.moduleBinaries = true

params {
    modules_testdata_base_path = '/nfs/treeoflife-01/resources/nextflow/test-data/'
}

process {
    withName: 'LONGC_PAIRTOOLSPARSE2' {
        ext.args = { params.longc_pairtoolsparse2_args }
    }

    withName: /PAIRTOOLS_.*|LONGC_PAIRTOOLSPARSE2/ {
        env.MPLCONFIGDIR = { "${task.workDir}/.matplotlib" }
        env.XDG_CACHE_HOME = { "${task.workDir}/.cache" }
    }

    withName: 'PAIRTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'PAIRTOOLS_RESTRICT' {
        ext.prefix = { "${meta.id}.restricted" }
    }

    withName: 'COOLER_CLOAD' {
        ext.args = { params.cooler_cload_args }
    }
}
